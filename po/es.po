msgid "Motion Modifier"
msgstr "Modificador de moción"

#: src/view.cpp:1355
msgid "Adjust mouse sensitivity. (relative motion only)"
msgstr "Ajustar sensibilidad de ratón. (solo moción relativa)"

#: src/view.cpp:1357
msgid "Invert Motion"
msgstr "Invertir moción"

#: src/view.cpp:1358
msgid "Invert mouse motion if needed. (relative motion only)"
msgstr "Invertir moción del ratón si es necesario. (solo moción relativa)"

